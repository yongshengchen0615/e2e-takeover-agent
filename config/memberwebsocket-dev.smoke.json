{
  "baseUrl": "https://memberwebsocket-dev-netlify.netlify.app",
  "steps": [
    {
      "name": "開啟 MemberWebsocket 開發入口",
      "action": "goto",
      "path": "/"
    },
    {
      "name": "確認開發站標題",
      "action": "assertText",
      "selector": "main h1",
      "text": "Supabase 測試站"
    },
    {
      "name": "確認會員中心導覽存在",
      "action": "assertVisible",
      "selector": "nav[aria-label=\"會員中心入口\"]"
    },
    {
      "name": "確認會員卡入口",
      "action": "assertVisible",
      "selector": "nav a[href=\"./member/\"]"
    },
    {
      "name": "確認預約入口",
      "action": "assertVisible",
      "selector": "nav a[href=\"./booking/\"]"
    },
    {
      "name": "確認管理入口",
      "action": "assertVisible",
      "selector": "nav a[href=\"./admin/\"]"
    }
  ],
  "acceptance": {
    "method": "QA / E2E",
    "criteria": [
      {
        "id": "QA-001",
        "title": "開發站首頁可識別",
        "required": true,
        "stepNames": [
          "確認開發站標題",
          "確認會員中心導覽存在"
        ]
      },
      {
        "id": "E2E-001",
        "title": "會員卡功能入口存在",
        "required": true,
        "stepNames": [
          "確認會員卡入口"
        ]
      },
      {
        "id": "E2E-002",
        "title": "預約功能入口存在",
        "required": true,
        "stepNames": [
          "確認預約入口"
        ]
      },
      {
        "id": "E2E-003",
        "title": "管理端功能入口存在",
        "required": true,
        "stepNames": [
          "確認管理入口"
        ]
      }
    ]
  }
}
